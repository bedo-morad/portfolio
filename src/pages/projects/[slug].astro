---
import Layout from '../../layouts/Layout.astro';
import Architecture from '../../components/Architecture.astro';
import { projects } from '../../projects';
import '../../styles/details.css';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.name} | Abdelrahman Mosad`}
  description={project.summary}
>
  <div class="wrap detail-wrap">
    <a class="back-link" href="/#projects">
      <span aria-hidden="true">←</span> All projects
    </a>

    <header class="project-header">
      <p class="project-category">{project.category}</p>
      <h1>{project.name}</h1>
      <p class="project-deck">{project.summary}</p>
      <ul class="tech-list" aria-label="Technologies used">
        {project.tech.map((technology) => (
          <li>{technology}</li>
        ))}
      </ul>
    </header>

    <dl class="project-meta">
      <div>
        <dt>Project</dt>
        <dd>{project.role}</dd>
      </div>
      <div>
        <dt>Contribution</dt>
        <dd>{project.scope}</dd>
      </div>
      <div>
        <dt>Availability</dt>
        <dd>{project.status}</dd>
      </div>
    </dl>

    <section class="detail-overview" aria-labelledby="overview-title">
      <h2 id="overview-title">Overview</h2>
      <p>{project.intro}</p>
    </section>

    <section class="detail-architecture" aria-labelledby="architecture-title">
      <div class="detail-section-intro">
        <h2 id="architecture-title">Architecture</h2>
        <p>{project.architecture}</p>
      </div>
      <Architecture diagram={project.diagram} />
    </section>

    <section class="features-section" aria-labelledby="features-title">
      <h2 id="features-title">What the project covers</h2>
      <div class="features-grid">
        {project.features.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    {project.screenshot && (
      <section class="screenshot-section" aria-labelledby="interface-title">
        <div class="section-heading">
          <h2 id="interface-title">Interface</h2>
          <a
            class="text-link"
            href={project.screenshot.source}
            target="_blank"
            rel="noopener noreferrer"
          >
            Repository source <span aria-hidden="true">↗</span>
          </a>
        </div>
        <figure
          class:list={[
            'project-screenshot',
            { portrait: project.slug === 'masa2o-ta7ady' },
          ]}
        >
          <img
            src={project.screenshot.src}
            alt={project.screenshot.alt}
            loading="lazy"
            width={project.slug === 'masa2o-ta7ady' ? 572 : 1440}
            height={project.slug === 'masa2o-ta7ady' ? 835 : 900}
          />
          <figcaption>
            Screenshot from the public {project.name} repository.
          </figcaption>
        </figure>
      </section>
    )}

    <section class="repository-section" aria-labelledby="source-title">
      <h2 id="source-title">Source code</h2>
      <div class="repository-links">
        {project.repos.map((repo) => (
          <a href={repo.url} target="_blank" rel="noopener noreferrer">
            <span>{repo.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
