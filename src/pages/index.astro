---
import Layout from '../layouts/Layout.astro';
import { projects } from '../projects';
import linkedInIcon from '../assets/brands/linkedin.svg?raw';
import whatsAppIcon from '../assets/brands/whatsapp.svg?raw';
---
<Layout home>
  <div class="wrap">
    <section id="home" class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <h1 id="intro-title">Abdelrahman Mosad<span class="name-period">.</span></h1>
        <p class="hero-role">Java Backend<br />Developer<span class="type-cursor" aria-hidden="true"></span></p>
        <p class="hero-description">Java and Spring Boot backend applications, with Angular web interfaces and Flutter mobile apps.</p>
        <div class="hero-actions"><a class="button primary" href="#projects">View projects <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M5 10h10m-4-4 4 4-4 4"/></svg></a><a class="button secondary" href="/Abdelrahman-Mosad-CV.pdf" download>Download CV <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M10 3v9m-4-4 4 4 4-4M4 13v4h12v-4"/></svg></a></div>
        <div class="hero-socials"><a href="https://github.com/bedo-morad" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.64-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a><a href="https://www.linkedin.com/in/abdelrahman-mosad" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile"><Fragment set:html={linkedInIcon} /></a><a href="https://wa.me/qr/RGZLX7UNPIJ7N1" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Abdelrahman"><Fragment set:html={whatsAppIcon} /></a><a href="mailto:bodymosad67@gmail.com" aria-label="Email Abdelrahman"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></a></div>
      </div>
      <div class="identity" aria-hidden="true"><div class="identity-orbit"></div><div class="identity-disc"><span class="identity-bracket">&#123;</span><span class="identity-letters">A<span>.</span>M</span><span class="identity-bracket">&#125;</span></div><span class="identity-tag tag-top">Java</span><span class="identity-tag tag-bottom">Spring Boot</span><span class="identity-caption">Backend, with the full picture.</span></div>
    </section>

    <section id="about" class="section about-section" aria-labelledby="about-title"><h2 id="about-title">About</h2><div class="about-copy about-description"><p>Java backend development with Spring Boot and REST APIs. Projects range from a book-lending prototype and e-commerce microservices to real-time chat and a football game-night application.</p><p>Backend work covers authentication with Spring Security and JWT or Keycloak, data storage with PostgreSQL, and Kafka messaging between services. Several projects also include Angular web interfaces.</p><p>Spring REST API work alongside senior developers during a backend internship at Connect Digital Solutions. Freelance Flutter development at Dropiedea Dijital VE Elektronik included EmirateSWP for Android and iOS.</p><a class="text-link" href="/Abdelrahman-Mosad-CV.pdf" download>Download the full CV <span aria-hidden="true">↗</span></a></div></section>

    <section id="experience" class="section experience-section" aria-labelledby="experience-title"><div class="section-heading"><div><h2 id="experience-title">Experience</h2><p>Development work.</p></div><a class="small-link" href="/Abdelrahman-Mosad-CV.pdf" download>Full CV <span aria-hidden="true">↗</span></a></div><div class="experience-list"><article class="experience"><div class="experience-icon" aria-hidden="true">&lt;/&gt;</div><div class="experience-body"><div class="experience-heading"><h3>Freelance Mobile Developer</h3><p class="experience-date">Mar 2024 to Jun 2024</p></div><p class="organization">Dropiedea Dijital VE Elektronik</p><p>EmirateSWP, built from scratch in Flutter for Android and iOS.</p></div></article><article class="experience"><div class="experience-icon" aria-hidden="true">&#123; &#125;</div><div class="experience-body"><div class="experience-heading"><h3>Backend Developer Intern</h3><p class="experience-date">Aug 2023 to Oct 2023</p></div><p class="organization">Connect Digital Solutions</p><p>Worked with senior developers on Spring REST APIs.</p></div></article></div><p class="service-note">Military service: April 2025 to June 2026.</p></section>

    <section id="education" class="section education-section" aria-labelledby="education-title"><div class="section-heading"><div><h2 id="education-title">Education</h2></div></div><div class="experience-list"><article class="experience education"><div class="experience-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5ZM6 11v6c4 3 8 3 12 0v-6m4-2v8"/></svg></div><div class="experience-body"><div class="experience-heading"><h3>Computer Science</h3><p class="experience-date">2020–2024</p></div><p class="organization">MTI University</p></div></article></div></section>


    <section id="projects" class="section projects-section" aria-labelledby="projects-title"><div class="section-heading"><div><h2 id="projects-title">Projects</h2><p>Backend systems and the interfaces around them.</p></div><div class="gallery-controls"><button class="gallery-prev icon-button" aria-label="Previous projects" aria-controls="project-gallery" disabled><span aria-hidden="true">←</span></button><button class="gallery-next icon-button" aria-label="Next projects" aria-controls="project-gallery"><span aria-hidden="true">→</span></button></div></div><div class="project-gallery" id="project-gallery" tabindex="0" role="region" aria-label="Project gallery"><div class="project-track">{projects.map(project=><article class={`project-card ${project.slug}`}><a class="project-card-link" href={`/projects/${project.slug}/`} aria-label={`Explore ${project.name}`}><div class="project-card-copy"><p class="project-category">{project.category}</p><h3>{project.name}</h3><p class="project-summary">{project.summary}</p><ul class="tech-list" aria-label={`${project.name} technologies`}>{project.tech.slice(0,4).map(t=><li>{t}</li>)}</ul><span class="project-detail-link">Explore project <span aria-hidden="true">↗</span></span></div></a></article>)}</div></div></section>

    <section id="contact" class="section contact-section" aria-labelledby="contact-title"><div class="contact-heading"><h2 id="contact-title">Get in touch.</h2><p>For backend roles and project enquiries.</p></div><div class="contact-panel"><div class="contact-email"><span>Email</span><a href="mailto:bodymosad67@gmail.com">bodymosad67@gmail.com <span aria-hidden="true">↗</span></a><button class="copy-email small-link" aria-label="Copy email address">Copy email</button><span class="copy-status" role="status" aria-live="polite"></span></div><div class="contact-bottom"><a href="tel:+201111677188">01111677188</a><div><a href="https://github.com/bedo-morad" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/abdelrahman-mosad" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href="https://wa.me/qr/RGZLX7UNPIJ7N1" target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a></div></div></div></section>
  </div>
  <script>
    const gallery=document.querySelector<HTMLElement>('.project-gallery');
    const prev=document.querySelector<HTMLButtonElement>('.gallery-prev');
    const next=document.querySelector<HTMLButtonElement>('.gallery-next');
    function galleryState(){if(!gallery||!prev||!next)return;prev.disabled=gallery.scrollLeft<8;next.disabled=gallery.scrollLeft>=gallery.scrollWidth-gallery.clientWidth-8}
    function slide(direction:number){if(!gallery)return;const card=gallery.querySelector<HTMLElement>('.project-card');gallery.scrollBy({left:direction*((card?.offsetWidth||330)+20),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})}
    prev?.addEventListener('click',()=>slide(-1));next?.addEventListener('click',()=>slide(1));gallery?.addEventListener('scroll',galleryState,{passive:true});window.addEventListener('resize',galleryState);galleryState();
    const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
    const emailLink = document.querySelector<HTMLAnchorElement>('.contact-email > a');
    const copyStatus = document.querySelector<HTMLElement>('.copy-status');

    function copyWithSelection(email: string) {
      const field = document.createElement('textarea');
      field.value = email;
      field.readOnly = true;
      field.setAttribute('aria-label', 'Email address to copy');
      field.style.cssText = 'position:fixed;left:-9999px;top:0';
      document.body.append(field);
      field.select();
      try {
        // Legacy compatibility only: the Clipboard API is always attempted first.
        return document.execCommand('copy');
      } catch {
        return false;
      } finally {
        field.remove();
        copyButton?.focus({ preventScroll: true });
      }
    }

    copyButton?.addEventListener('click', async () => {
      if (!emailLink || !copyStatus) return;
      const email = emailLink.href.slice('mailto:'.length);
      copyStatus.textContent = '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        copied = copyWithSelection(email);
      }
      if (copied) {
        copyStatus.textContent = 'Email copied.';
      } else {
        const range = document.createRange();
        if (emailLink.firstChild) range.selectNodeContents(emailLink.firstChild);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        copyStatus.textContent = 'Copy unavailable. Select and copy the email address.';
      }
    });
  </script>
</Layout>
